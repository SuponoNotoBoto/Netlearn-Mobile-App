    "arObjKomputerName":  "Desktop Computer",
    "arObjKomputerDesc":  "An end device that sends and receives data over the network.",
    "arObjSwitchName":  "Switch",
    "arObjSwitchDesc":  "Connects devices in a local network and forwards frames to the destination port using MAC addresses.",
    "arObjHubName":  "Hub",
    "arObjHubDesc":  "Connects devices and repeats incoming data to every connected port, unlike a switch that forwards only to the target device.",
    "arObjRouterName":  "Router",
    "arObjRouterDesc":  "Connects different networks and forwards packets between them using IP addresses and a routing table.",
    "arObjTopologiName":  "Star Topology",
    "arObjTopologiDesc":  "A topology where every device connects to a central switch. The central device is critical: if it fails, the whole network is affected.",
    "arObjIpAddressName":  "IP Address Simulation",
    "arObjIpAddressDesc":  "Configure the IPv4 address and subnet mask of two computers connected through one switch.",
